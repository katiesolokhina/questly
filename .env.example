# Copy to .env and fill in. Never commit .env.

NODE_ENV=production
PORT=3001

# MongoDB connection string, including the database name (e.g. .../questly).
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/questly

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-me-with-a-long-random-string

# Public origin. Requests from any other origin are rejected.
APP_ORIGIN=http://localhost:3001

# Optional: quotes and advice after each check-in (https://api-ninjas.com). Fallbacks are used without it.
API_NINJAS_KEY=

# Optional: push notifications. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional: backups (scripts/backup.js)
# BACKUP_DIR=./backups
# BACKUP_KEEP=14
