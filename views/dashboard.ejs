<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <link rel="stylesheet" href="/css/dashboard.css">
  <script src="/js/push-setup.js" defer></script>
  <title><%= habit ? habit.name + ' · ' : '' %>Questly</title>
</head>
<body>
<div class="app">

<header class="topbar">
  <div class="brand">
    <img class="logo-img" src="/icons/logo-mark.svg" alt="" width="32" height="32">
    <span class="brand-name">Questly</span>
  </div>
  <form method="post" action="/logout">
    <button class="icon-btn" type="submit" aria-label="Sign out">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="M16 17l5-5-5-5"/><path d="M21 12H9"/></svg>
    </button>
  </form>
</header>

  <nav class="chips" aria-label="Habits">
    <% habits.forEach((h) => { const on = habit && h.id === habit.id; %>
      <a class="chip<%= on ? ' chip-on' : '' %>" href="/?h=<%= h.id %>"<%- on ? ' aria-current="page"' : '' %>>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="<%= icons[h.icon] %>"/></svg>
        <%= h.name %>
      </a>
    <% }) %>
    <a class="chip chip-new" href="/habits/new">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
      New habit
    </a>
  </nav>

<% if (!habit) { %>
  <main class="empty card">
    <h1>No habits yet</h1>
    <p class="muted">Add your first one to start tracking.</p>
    <a class="btn btn-primary" href="/habits/new">Create a habit</a>
  </main>
<% } else { %>
  <main class="stack">

    <div class="title-row">
      <div class="title-text">
        <span class="muted subtitle"><%= todayLabel %> · <%= scheduleLabel %></span>
        <h1><%= habit.name %> · <%= stats.dayOfCourse ? 'Day ' + stats.dayOfCourse : 'Not started' %></h1>
      </div>
      <a class="icon-btn icon-btn-card" href="/habits/<%= habit.id %>/edit" aria-label="Edit <%= habit.name %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
      </a>
    </div>

    <% if (todayCheckin) { %>
      <section class="done-card" aria-live="polite">
        <div class="done-row">
          <div class="done-info">
            <span class="check-badge" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
            </span>
            <div>
              <p class="done-title">Done for today</p>
              <p class="muted small-14">Logged at <%= todayCheckin.time %></p>
            </div>
          </div>
          <form method="post" action="/habits/<%= habit.id %>/checkin/undo">
            <input type="hidden" name="m" value="<%= ym %>">
            <button class="link-btn" type="submit">Undo</button>
          </form>
        </div>
        <% if (todayCheckin.message) { %>
          <figure class="quote">
            <span class="quote-kicker"><%= todayCheckin.message.type === 'advice' ? "Today's advice" : "Today's quote" %></span>
            <blockquote>“<%= todayCheckin.message.text %>”</blockquote>
            <% if (todayCheckin.message.author) { %><figcaption>— <%= todayCheckin.message.author %></figcaption><% } %>
          </figure>
        <% } %>
      </section>
    <% } else if (scheduledToday) { %>
      <form method="post" action="/habits/<%= habit.id %>/checkin">
        <input type="hidden" name="m" value="<%= ym %>">
        <button class="btn-checkin" type="submit">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
          Check in for today
        </button>
      </form>
    <% } else { %>
      <section class="rest-card">
        <div>
          <p class="rest-title">Rest day</p>
          <p class="small-14 rest-sub">Not scheduled on <%= todayDayName %>s</p>
        </div>
        <form method="post" action="/habits/<%= habit.id %>/checkin">
          <input type="hidden" name="m" value="<%= ym %>">
          <button class="btn-outline" type="submit">Log anyway</button>
        </form>
      </section>
    <% } %>

    <div class="stats">
      <div class="stat">
        <span class="stat-label">Streak</span>
        <span class="stat-value stat-accent"><%= stats.streak %></span>
        <span class="stat-unit"><%= streakUnit %></span>
      </div>
      <div class="stat">
        <span class="stat-label">Total</span>
        <span class="stat-value"><%= stats.total %></span>
        <span class="stat-unit"><%= totalUnit %></span>
      </div>
      <div class="stat">
        <span class="stat-label"><%= monthShort %></span>
        <span class="stat-value"><%= stats.adherence === null ? '—' : stats.adherence + '%' %></span>
        <span class="stat-unit">on schedule</span>
      </div>
    </div>

    <section class="calendar" aria-labelledby="cal-title">
      <div class="cal-head">
        <% if (prevYm) { %>
          <a class="icon-btn" href="/?h=<%= habit.id %>&m=<%= prevYm %>" aria-label="Previous month">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
          </a>
        <% } else { %><span class="icon-btn" aria-hidden="true"></span><% } %>
        <h2 id="cal-title"><%= monthLabel %></h2>
        <% if (nextYm) { %>
          <a class="icon-btn" href="/?h=<%= habit.id %>&m=<%= nextYm %>" aria-label="Next month">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
          </a>
        <% } else { %><span class="icon-btn" aria-hidden="true"></span><% } %>
      </div>
      <table class="cal">
        <thead>
          <tr>
            <% weekHead.forEach((w) => { %>
              <th scope="col" abbr="<%= w.full %>" class="<%= w.scheduled ? '' : 'wd-off' %>"><%= w.letter %></th>
            <% }) %>
          </tr>
        </thead>
        <tbody>
          <% weeks.forEach((week) => { %>
            <tr>
              <% week.forEach((c) => { %>
                <% if (!c.inMonth) { %>
                  <td></td>
                <% } else { %>
                  <td>
  <% if (['done', 'missed', 'off'].includes(c.status)) { %>
    <a class="day day-<%= c.status %> day-link" href="/habits/<%= habit.id %>/day/<%= c.date %>?m=<%= ym %>"><%= c.day %><span class="sr-only">, <%= c.label %>. Edit</span></a>
  <% } else { %>
    <span class="day day-<%= c.status %>"<%- c.status.startsWith('today') ? ' aria-current="date"' : '' %>><%= c.day %><% if (c.label) { %><span class="sr-only">, <%= c.label %></span><% } %></span>
  <% } %>
</td>
                <% } %>
              <% }) %>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </section>

    <ul class="legend" aria-label="Legend">
      <li><span class="key key-done"></span>Done</li>
      <li><span class="key key-missed"></span>Missed</li>
      <li><span class="key key-today"></span>Today</li>
      <li><span class="key key-off"></span>Off day</li>
    </ul>
    <section class="push-card" id="push-card" hidden aria-live="polite">
  <div data-state="off" hidden>
    <p class="push-title">Get reminders on this device</p>
    <p class="small-14 muted">Questly nudges you at each habit's reminder time, only if you haven't checked in.</p>
    <button class="btn-outline" type="button" data-action="enable">Turn on reminders</button>
  </div>
  <div data-state="on" hidden>
    <p class="push-title">Reminders are on for this device</p>
    <div class="push-actions">
      <button class="link-btn" type="button" data-action="test">Send a test</button>
      <button class="link-btn" type="button" data-action="disable">Turn off</button>
    </div>
  </div>
  <div data-state="blocked" hidden>
    <p class="push-title">Notifications are blocked</p>
    <p class="small-14 muted">Allow notifications for Questly in your phone's settings, then reopen the app.</p>
  </div>
  <p class="small-14 muted" data-status></p>
</section>
  </main>
<% } %>
</div>
</body>
</html>
