<!doctype html>
<html lang="en"<%- theme ? ` data-theme="${theme}"` : '' %>>
<head>
  <%- include('partials/head') %>
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/counter.css">
  <link rel="stylesheet" href="/css/rating.css">
  <link rel="stylesheet" href="/css/milestones.css">
  <link rel="stylesheet" href="/css/demo.css">
  <script src="/js/push-setup.js" defer></script>
  <script src="/js/timer.js" defer></script>
  <title><%= habit ? habit.name + ' · ' : '' %>Questly</title>
</head>
<body>
<div class="app">

<header class="topbar">
  <div class="brand">
    <img class="logo-img" src="/icons/logo-mark.svg" alt="" width="32" height="32">
    <span class="brand-name">Questly</span>
  </div>
  <div class="topbar-actions">
    <button class="icon-btn bell" id="push-bell" type="button" hidden aria-label="Turn on reminders">
  <svg class="bell-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
  <svg class="bell-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13.73 21a2 2 0 0 1-3.46 0"/><path d="M18.63 13A17.89 17.89 0 0 1 18 8"/><path d="M6.26 6.26A5.86 5.86 0 0 0 6 8c0 7-3 9-3 9h14"/><path d="M18 8a6 6 0 0 0-9.33-5"/><path d="M1 1l22 22"/></svg>
</button>
  <a class="icon-btn" href="/settings" aria-label="Settings">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.6 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.6a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
  </a>
  <form method="post" action="/logout">
    <button class="icon-btn" type="submit" aria-label="Sign out">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="M16 17l5-5-5-5"/><path d="M21 12H9"/></svg>
    </button>
  </form>
  </div>
</header>

  <nav class="chips" aria-label="Habits">
    <% habits.forEach((h) => { const on = habit && h.id === habit.id; %>
      <a class="chip<%= on ? ' chip-on' : '' %>" href="/?h=<%= h.id %>"<%- on ? ' aria-current="page"' : '' %>>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="<%= icons[h.icon] %>"/></svg>
        <%= h.name %>
      </a>
    <% }) %>
    <a class="chip chip-new" href="/habits/new">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
      New habit
    </a>
  </nav>

  <%- include('partials/demo-banner') %>
<% if (!habit) { %>
  <main class="empty card">
    <h1>No habits yet</h1>
    <p class="muted">Add your first one to start tracking.</p>
    <a class="btn btn-primary" href="/habits/new">Create a habit</a>
  </main>
<% } else { %>
  <main class="stack">

    <div class="title-row">
      <div class="title-text">
        <span class="muted subtitle"><%= todayLabel %> · <%= scheduleLabel %></span>
        <h1><%= habit.name %> · <%= stats.dayOfCourse ? 'Day ' + stats.dayOfCourse : 'Not started' %></h1>
      </div>
      <a class="icon-btn icon-btn-card" href="/habits/<%= habit.id %>/edit" aria-label="Edit <%= habit.name %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
      </a>
    </div>
    <% if (habit.description || (habit.link && habit.link.url)) { %>
  <div class="habit-details">
    <% if (habit.description) { %><p class="habit-desc"><%= habit.description %></p><% } %>
    <% if (habit.link && habit.link.url) { %>
      <a class="habit-link" href="<%= habit.link.url %>" target="_blank" rel="noopener noreferrer">
        <%= habit.link.label || new URL(habit.link.url).hostname.replace(/^www\./, '') %>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3h7v7"/><path d="M10 14L21 3"/><path d="M21 14v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5"/></svg>
        <span class="sr-only">(opens in a new tab)</span>
      </a>
    <% } %>
  </div>
<% } %>
<% if (pauseBanner) { %>
  <div class="pause-banner" role="status">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="6" y="4" width="4" height="16" rx="1"/><rect x="14" y="4" width="4" height="16" rx="1"/></svg>
    <div class="pause-banner-text">
      <span class="pause-banner-title"><%= pauseBanner.active ? 'Paused' : 'Pause planned' %> · <%= pauseBanner.reason %></span>
      <span class="pause-banner-sub"><%= pauseBanner.range %> · no reminders, streak kept</span>
    </div>
    <a class="pause-banner-link" href="/habits/<%= habit.id %>/pauses">Manage</a>
  </div>
<% } %>
<%- include('partials/timer') %>
    <% if (todayCheckin) { %>
      <section class="done-card" aria-live="polite">
        <div class="done-row">
          <div class="done-info">
            <span class="check-badge" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
            </span>
            <div>
              <p class="done-title">Done for today</p>
              <p class="muted small-14">Logged at <%= todayCheckin.time %><% if (todayCheckin.timed) { %> · <%= todayCheckin.timed %> timed<% } %></p>            </div>
          </div>
          <form method="post" action="/habits/<%= habit.id %>/checkin/undo">
            <input type="hidden" name="m" value="<%= ym %>">
            <button class="link-btn" type="submit">Undo</button>
          </form>
        </div>
        <% if (todayCheckin.message) { %>
          <figure class="quote">
            <span class="quote-kicker"><%= todayCheckin.message.type === 'advice' ? "Today's advice" : "Today's quote" %></span>
            <blockquote>“<%= todayCheckin.message.text %>”</blockquote>
            <% if (todayCheckin.message.author) { %><figcaption>— <%= todayCheckin.message.author %></figcaption><% } %>
          </figure>
        <% } %>
      </section>
    <% } else if (scheduledToday) { %>
      <form method="post" action="/habits/<%= habit.id %>/checkin">
        <input type="hidden" name="m" value="<%= ym %>">
        <button class="btn-checkin<%= timer ? ' btn-checkin-alt' : '' %>" type="submit">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
          <%= timer ? 'Check in without timing' : 'Check in for today' %>
        </button>
      </form>
    <% } else { %>
      <section class="rest-card">
        <div>
          <% if (pausedToday) { %>
  <p class="rest-title">Paused today</p>
  <p class="small-14 rest-sub">Nothing expected. Your streak is safe.</p>
<% } else { %>
  <p class="rest-title">Rest day</p>
  <p class="small-14 rest-sub">Not scheduled on <%= todayDayName %>s</p>
<% } %>
        </div>
        <form method="post" action="/habits/<%= habit.id %>/checkin">
          <input type="hidden" name="m" value="<%= ym %>">
          <button class="btn-outline" type="submit">Log anyway</button>
        </form>
      </section>
    <% } %>

    <% if (rating) { %><%- include('partials/rating-chips', { ratingDate: today, ratingQuestion: rating.question, ratingChips: rating.chips, ratingBack: 'home', ratingM: ym }) %><% } %>
    <a class="today-note" href="/habits/<%= habit.id %>/day/<%= today %>?m=<%= ym %>">
  <% if (todayNote) { %>
    <span class="today-note-label">Today's note</span>
    <span class="today-note-text"><%= todayNote %></span>
  <% } else { %>
    <span class="today-note-add">+ Add a note for today</span>
  <% } %>
</a>

<%- include('partials/counter-card') %>
    <div class="stats">
      <div class="stat">
        <span class="stat-label">Streak</span>
        <span class="stat-value stat-accent"><%= stats.streak %></span>
        <span class="stat-unit"><%= streakUnit %></span>
      </div>
      <div class="stat">
        <span class="stat-label">Total</span>
        <span class="stat-value"><%= stats.total %></span>
        <span class="stat-unit"><%= totalUnit %></span>
      </div>
      <div class="stat">
        <span class="stat-label"><%= monthShort %></span>
        <span class="stat-value"><%= stats.adherence === null ? '—' : stats.adherence + '%' %></span>
        <span class="stat-unit">on schedule</span>
      </div>
    </div>

    <%- include('partials/milestones') %>
    <section class="calendar" aria-labelledby="cal-title">
      <div class="cal-head">
        <% if (prevYm) { %>
          <a class="icon-btn" href="/?h=<%= habit.id %>&m=<%= prevYm %>" aria-label="Previous month">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
          </a>
        <% } else { %><span class="icon-btn" aria-hidden="true"></span><% } %>
        <h2 id="cal-title"><%= monthLabel %></h2>
        <% if (nextYm) { %>
          <a class="icon-btn" href="/?h=<%= habit.id %>&m=<%= nextYm %>" aria-label="Next month">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
          </a>
        <% } else { %><span class="icon-btn" aria-hidden="true"></span><% } %>
      </div>
      <table class="cal">
        <thead>
          <tr>
            <% weekHead.forEach((w) => { %>
              <th scope="col" abbr="<%= w.full %>" class="<%= w.scheduled ? '' : 'wd-off' %>"><%= w.letter %></th>
            <% }) %>
          </tr>
        </thead>
        <tbody>
          <% weeks.forEach((week) => { %>
            <tr>
              <% week.forEach((c) => { %>
                <% if (!c.inMonth) { %>
                  <td></td>
                <% } else { %>
                  <td>
<% if (['done', 'missed', 'off', 'today', 'today-done'].includes(c.status) || (c.status === 'paused' && c.date < today)) { %>
  <a class="day day-<%= c.status %> day-link<%= c.hasNote ? ' has-note' : '' %>" href="/habits/<%= habit.id %>/day/<%= c.date %>?m=<%= ym %>"<%- c.status.startsWith('today') ? ' aria-current="date"' : '' %>><%= c.day %><span class="sr-only">, <%= c.label %><%= c.hasNote ? ', has a note' : '' %>. Open</span></a>
  <% } else { %>
    <span class="day day-<%= c.status %>"<%- c.status.startsWith('today') ? ' aria-current="date"' : '' %>><%= c.day %><% if (c.label) { %><span class="sr-only">, <%= c.label %></span><% } %></span>
  <% } %>
</td>
                <% } %>
              <% }) %>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </section>

    <ul class="legend" aria-label="Legend">
      <li><span class="key key-done"></span>Done</li>
      <li><span class="key key-missed"></span>Missed</li>
      <li><span class="key key-today"></span>Today</li>
      <li><span class="key key-off"></span>Off day</li>
      <li><span class="key key-paused"></span>Paused</li>
    </ul>
    <div class="dash-links">
  <a class="plan-pause" href="/week">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 2v4M16 2v4"/></svg>
    Your week
  </a>
    <a class="plan-pause" href="/habits/<%= habit.id %>/pauses">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="6" y="4" width="4" height="16" rx="1"/><rect x="14" y="4" width="4" height="16" rx="1"/></svg>
  Plan a pause
</a>
</div>
<%- include('partials/rating-trend') %>
  </main>
<% } %>
</div>
</body>
</html>
