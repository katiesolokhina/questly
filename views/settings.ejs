<!doctype html>
<html lang="en"<%- theme ? ` data-theme="${theme}"` : '' %>>
<head>
  <%- include('partials/head') %>
  <link rel="stylesheet" href="/css/habit-form.css">
  <link rel="stylesheet" href="/css/settings.css">
  <script src="/js/habit-form.js" defer></script>
  <script src="/js/share-link.js" defer></script>
  <script src="/js/push-setup.js" defer></script>
  <title>Settings · Questly</title>
</head>
<body>
<div class="form-page">
  <header class="form-bar">
    <a class="bar-link" href="/">Done</a>
    <h1>Settings</h1>
    <span class="bar-spacer" aria-hidden="true"></span>
  </header>

  <main class="settings">
    <% if (saved) { %>
      <p class="alert alert-ok" role="status"><%= saved %></p>
    <% } %>

    <!-- Account -->
    <section class="panel" aria-labelledby="account-title">
      <h2 id="account-title">Account</h2>
      <p class="muted small-14">Signed in as <strong><%= user.email %></strong></p>

      <form class="stack-form" method="post" action="/settings/password" novalidate>
        <h3>Change password</h3>
        <% if (pwErrors.form) { %><p class="alert" role="alert"><%= pwErrors.form %></p><% } %>
        <div class="field">
          <label for="currentPassword">Current password</label>
          <input id="currentPassword" name="currentPassword" type="password" autocomplete="current-password" required
            <%- pwErrors.currentPassword ? 'aria-invalid="true" aria-describedby="cur-err"' : '' %>>
          <% if (pwErrors.currentPassword) { %><span class="field-error" id="cur-err"><%= pwErrors.currentPassword %></span><% } %>
        </div>
        <div class="field">
          <label for="newPassword">New password</label>
          <input id="newPassword" name="newPassword" type="password" autocomplete="new-password" minlength="8" required
            <%- pwErrors.newPassword ? 'aria-invalid="true" aria-describedby="new-err"' : 'aria-describedby="new-hint"' %>>
          <% if (pwErrors.newPassword) { %><span class="field-error" id="new-err"><%= pwErrors.newPassword %></span><% } else { %>
            <span class="hint" id="new-hint">At least 8 characters. A short phrase works well.</span>
          <% } %>
        </div>
        <div class="field">
          <label for="confirmPassword">Confirm new password</label>
          <input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" required
            <%- pwErrors.confirmPassword ? 'aria-invalid="true" aria-describedby="conf-err"' : '' %>>
          <% if (pwErrors.confirmPassword) { %><span class="field-error" id="conf-err"><%= pwErrors.confirmPassword %></span><% } %>
        </div>
        <button class="btn btn-primary" type="submit">Change password</button>
        <p class="hint">This signs you out on all your other devices.</p>
      </form>
    </section>

    <!-- Notifications -->
    <section class="panel" id="notifications" aria-labelledby="notif-title">
      <h2 id="notif-title">Notifications</h2>
      <div id="push-card" hidden aria-live="polite">
        <div data-state="off" hidden>
          <p class="push-title">Reminders are off on this device</p>
          <p class="small-14 muted">Questly nudges you at each habit's reminder time, only if you haven't checked in. Set the time in each habit's settings.</p>
          <button class="btn-outline" type="button" data-action="enable">Turn on reminders</button>
        </div>
        <div data-state="on" hidden>
          <p class="push-title">Reminders are on for this device</p>
          <p class="small-14 muted">Each phone or computer is set up separately.</p>
          <div class="push-actions">
            <button class="link-btn" type="button" data-action="test">Send a test</button>
            <button class="link-btn link-btn-danger" type="button" data-action="disable">Turn off</button>
          </div>
        </div>
        <div data-state="blocked" hidden>
          <p class="push-title">Notifications are blocked</p>
          <p class="small-14 muted">Questly isn't allowed to notify you on this device. Allow notifications for Questly (or your browser) in your phone's or computer's settings, then reopen the app.</p>
        </div>
        <p class="small-14 muted" data-status></p>
      </div>
      <noscript><p class="small-14 muted">Reminders need JavaScript turned on.</p></noscript>
    </section>

    <!-- Appearance -->
    <section class="panel" aria-labelledby="look-title">
      <h2 id="look-title">Appearance</h2>
      <form method="post" action="/settings/theme">
        <div class="segmented segmented-3" role="group" aria-label="Theme">
          <% [['system', 'System'], ['light', 'Light'], ['dark', 'Dark']].forEach(([value, label]) => { %>
            <button type="submit" name="theme" value="<%= value %>" aria-pressed="<%= user.theme === value %>"
              class="seg-btn<%= user.theme === value ? ' seg-on' : '' %>"><%= label %></button>
          <% }) %>
        </div>
      </form>
      <p class="hint">System follows your phone or computer setting.</p>
    </section>

    <!-- Archived habits -->
    <section class="panel" aria-labelledby="archived-title">
      <h2 id="archived-title">Archived habits</h2>
      <% if (!archived.length) { %>
        <p class="muted small-14">Nothing archived. Habits you archive show up here, with their history kept.</p>
      <% } else { %>
        <ul class="archived-list">
          <% archived.forEach((h) => { %>
            <li>
              <span class="archived-name">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="<%= icons[h.icon] %>"/></svg>
                <%= h.name %>
              </span>
              <div class="archived-actions">
                <form method="post" action="/settings/habits/<%= h._id %>/restore">
                  <button class="btn-outline" type="submit">Restore<span class="sr-only"> <%= h.name %></span></button>
                </form>
                <a class="link-danger" href="/habits/<%= h._id %>/delete?from=settings">Delete<span class="sr-only"> <%= h.name %></span></a>
              </div>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </section>

    <% if (family) { %>
    <!-- Family (admin only) -->
    <section class="panel" id="family" aria-labelledby="family-title">
      <h2 id="family-title">Family</h2>
      <p class="muted small-14">Each person gets a private account. You can manage accounts, but you can't see anyone's habits.</p>

      <% if (family.link) { %>
        <div class="link-card" role="status">
          <p class="link-title">
            <%= family.link.kind === 'invite' ? 'Invite link' : 'Password reset link' %><%= family.link.label ? ' for ' + family.link.label : '' %>
          </p>
          <input class="link-input" type="text" readonly value="<%= family.link.url %>" aria-label="Link" data-link-input>
          <div class="link-actions">
            <button class="btn-outline" type="button" data-share-link="<%= family.link.url %>">Share</button>
            <button class="btn-outline" type="button" data-copy-link="<%= family.link.url %>">Copy</button>
          </div>
          <p class="hint">Works once, for <%= family.link.days === 1 ? '24 hours' : family.link.days + ' days' %>. This is the only time it's shown, so send it now.</p>
        </div>
      <% } %>

      <form class="invite-form" method="post" action="/settings/family/invites">
        <div class="field">
          <label for="inviteLabel">Who's it for? <span class="muted">(optional)</span></label>
          <input id="inviteLabel" name="label" type="text" maxlength="40" placeholder="e.g. Mom">
        </div>
        <button class="btn btn-primary" type="submit">Create invite link</button>
      </form>

      <% if (family.invites.length) { %>
        <h3>Waiting to be used</h3>
        <ul class="row-list">
          <% family.invites.forEach((inv) => { %>
            <li>
              <span><strong><%= inv.label || 'Unnamed invite' %></strong>
                <span class="muted small-14"> · expires <%= inv.expiresAt.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %></span></span>
              <form method="post" action="/settings/family/invites/<%= inv._id %>/revoke">
                <button class="link-btn" type="submit">Cancel<span class="sr-only"> invite<%= inv.label ? ' for ' + inv.label : '' %></span></button>
              </form>
            </li>
          <% }) %>
        </ul>
      <% } %>

      <h3>Accounts</h3>
      <% if (!family.members.length) { %>
        <p class="muted small-14">No one else yet.</p>
      <% } else { %>
        <ul class="row-list members">
          <% family.members.forEach((m) => { %>
            <li>
              <div class="member-info">
                <strong><%= m.name %></strong><% if (m.disabled) { %> <span class="badge-off">Off</span><% } %>
                <span class="muted small-14"><%= m.email %></span>
              </div>
              <div class="member-actions">
                <% if (!m.disabled) { %>
                  <form method="post" action="/settings/family/members/<%= m._id %>/reset">
                    <button class="link-btn" type="submit">Reset link<span class="sr-only"> for <%= m.name %></span></button>
                  </form>
                  <form method="post" action="/settings/family/members/<%= m._id %>/disable"
                    data-confirm="Turn off <%= m.name %>'s account? They'll be signed out and can't sign in until you turn it back on. Their data is kept.">
                    <button class="link-btn" type="submit">Turn off<span class="sr-only"> <%= m.name %></span></button>
                  </form>
                <% } else { %>
                  <form method="post" action="/settings/family/members/<%= m._id %>/enable">
                    <button class="link-btn" type="submit">Turn on<span class="sr-only"> <%= m.name %></span></button>
                  </form>
                <% } %>
                <a class="link-danger" href="/settings/family/members/<%= m._id %>/delete">Delete<span class="sr-only"> <%= m.name %></span></a>
              </div>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </section>
    <% } %>

    <!-- Export -->
    <section class="panel" aria-labelledby="export-title">
      <h2 id="export-title">Export</h2>
      <p class="muted small-14">Every habit, every day since it started: done, missed, or off, and how each was logged. Opens in Excel or Google Sheets.</p>
      <a class="btn btn-outline-aqua" href="/settings/export.csv" download>Download CSV</a>
    </section>
  </main>
</div>
</body>
</html>
