<!doctype html>
<html lang="en"<%- theme ? ` data-theme="${theme}"` : '' %>>
<head>
  <%- include('partials/head') %>
  <link rel="stylesheet" href="/css/habit-form.css">
  <link rel="stylesheet" href="/css/day.css">
  <title><%= dateLabel %> · <%= habit.name %> · Questly</title>
</head>
<body>
<div class="form-page">
  <header class="form-bar">
    <a class="bar-link" href="<%= back %>">Back</a>
    <h1><%= isToday ? 'Today' : dateLabel %></h1>
    <span class="bar-spacer" aria-hidden="true"></span>
  </header>

  <main class="day-body">
    <p class="day-habit">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="<%= icons[habit.icon] %>"/></svg>
      <%= habit.name %><% if (isToday) { %> · <%= dateLabel %><% } %>
    </p>

    <section class="day-status day-status-<%= status.kind %>">
      <span class="day-dot" aria-hidden="true"></span>
      <div>
        <p class="day-status-title"><%= status.title %></p>
        <p class="day-status-detail"><%= status.detail %></p>
      </div>
    </section>

    <% if (!isToday && status.kind === 'done') { %>
      <form method="post" action="/habits/<%= habit.id %>/day/<%= date %>">
        <input type="hidden" name="action" value="remove">
        <input type="hidden" name="m" value="<%= m %>">
        <button class="btn btn-danger-outline btn-block" type="submit">Remove check-in</button>
      </form>
    <% } else if (!isToday && (status.kind === 'missed' || status.kind === 'off')) { %>
      <form method="post" action="/habits/<%= habit.id %>/day/<%= date %>">
        <input type="hidden" name="action" value="add">
        <input type="hidden" name="m" value="<%= m %>">
        <button class="btn btn-primary btn-block" type="submit"><%= status.kind === 'off' ? 'Log anyway' : 'Mark as done' %></button>
      </form>
      <p class="hint center">It will be noted as added later.</p>
    <% } %>

    <form class="note-form" method="post" action="/habits/<%= habit.id %>/day/<%= date %>/note" novalidate>
      <input type="hidden" name="m" value="<%= m %>">
      <div class="field">
        <label for="note">Note</label>
        <textarea id="note" name="note" rows="4" maxlength="<%= noteMax %>" placeholder="Symptoms, how you felt, anything worth remembering"
          <%- noteError ? 'aria-invalid="true" aria-describedby="note-err"' : 'aria-describedby="note-hint"' %>><%= noteText %></textarea>
        <% if (noteError) { %><span class="field-error" id="note-err"><%= noteError %></span><% } else { %>
          <span class="hint" id="note-hint">Only you can see this. Clear it and save to delete the note.</span><% } %>
      </div>
      <div class="note-actions">
        <button class="btn btn-outline-aqua" type="submit">Save note</button>
        <% if (noteSaved) { %><span class="note-saved" role="status">Saved</span><% } %>
      </div>
    </form>
  </main>
</div>
</body>
</html>
