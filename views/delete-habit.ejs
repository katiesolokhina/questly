<!doctype html>
<html lang="en"<%- theme ? ` data-theme="${theme}"` : '' %>>
<head>
  <%- include('partials/head') %>
  <link rel="stylesheet" href="/css/habit-form.css">
  <title>Delete <%= habit.name %> · Questly</title>
</head>
<body>
<div class="form-page">
  <header class="form-bar">
    <a class="bar-link" href="<%= from === 'settings' ? '/settings' : '/habits/' + habit.id + '/edit' %>">Cancel</a>
    <h1>Delete habit</h1>
    <span class="bar-spacer" aria-hidden="true"></span>
  </header>

  <form class="form-body" method="post" action="/habits/<%= habit.id %>/delete" novalidate>
    <input type="hidden" name="from" value="<%= from %>">

    <div class="delete-card">
      <p class="delete-habit">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="<%= icons[habit.icon] %>"/></svg>
        <%= habit.name %>
      </p>
      <% if (count > 0) { %>
        <p>This permanently erases <strong><%= habit.name %></strong> and its <strong><%= count %> check-in<%= count === 1 ? '' : 's' %></strong>. It can't be undone.</p>
        <% if (!habit.archived) { %><p class="hint">To hide it but keep the history, archive it instead.</p><% } %>
      <% } else { %>
        <p>This habit has no check-ins. Delete it?</p>
      <% } %>
    </div>

    <% if (count > 0) { %>
      <div class="field">
        <label for="confirmName">Type <strong><%= habit.name %></strong> to confirm</label>
        <input id="confirmName" name="confirmName" type="text" autocomplete="off" autocapitalize="off" spellcheck="false"
          <%- error ? 'aria-invalid="true" aria-describedby="confirm-error"' : '' %> autofocus>
        <% if (error) { %><span class="field-error" id="confirm-error"><%= error %></span><% } %>
      </div>
    <% } %>

    <button class="btn btn-danger btn-block" type="submit">Delete permanently</button>
  </form>
</div>
</body>
</html>
