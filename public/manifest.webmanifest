{
  "id": "/",
  "name": "Questly",
  "short_name": "Questly",
  "description": "Daily habit and medication check-ins",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#DCCBFA",
  "theme_color": "#F7F4FB",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
    "shortcuts": [
    { "name": "Check in for today", "short_name": "Check in", "url": "/go/checkin", "icons": [{ "src": "/icons/shortcut-checkin.png", "sizes": "96x96", "type": "image/png" }] },
    { "name": "Add a note for today", "short_name": "Note", "url": "/go/note", "icons": [{ "src": "/icons/shortcut-note.png", "sizes": "96x96", "type": "image/png" }] },
    { "name": "Your week", "short_name": "Week", "url": "/week", "icons": [{ "src": "/icons/shortcut-week.png", "sizes": "96x96", "type": "image/png" }] }
  ]
}
